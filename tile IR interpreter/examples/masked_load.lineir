# unified-tile-ir line-format v0
# source_lang=triton
# source=examples/masked_load.lineir
# max_ops=220
0000 | kernel       | name=masked_load params="src,alt,dst,n"
0001 | arange       | out=offsets stop=8
0002 | lt           | out=inbounds lhs=offsets rhs=n
0003 | load         | out=v ptr="src + offsets" mask=inbounds other=-1.0
0004 | load         | out=u ptr="alt + offsets" mask=inbounds other=0.5
0005 | add          | out=w lhs=v rhs=u
0006 | lt           | out=keep lhs=offsets rhs=7
0007 | store        | ptr="dst + offsets" value=w mask=keep
0008 | return       | value=w
